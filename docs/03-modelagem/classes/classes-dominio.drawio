        <mxCell id="Fornecedor" value="&lt;b&gt;Fornecedor&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;nome&lt;br&gt;documento&lt;br&gt;contato" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="150" width="320" height="240" />
        </mxCell>
