          <mxGeometry as="geometry" x="600" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="ItemCompra" value="&lt;b&gt;ItemCompra&lt;/b&gt;&lt;hr&gt;quantidade&lt;br&gt;unidadeMedida&lt;br&gt;precoUnitario" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="RecebimentoInsumo" value="&lt;b&gt;RecebimentoInsumo&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;dataRecebimento" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="600" y="600" width="320" height="240" />
        </mxCell>
        <mxCell id="ItemRecebimento" value="&lt;b&gt;ItemRecebimento&lt;/b&gt;&lt;hr&gt;quantidadeRecebida&lt;br&gt;unidadeMedida" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="600" width="320" height="240" />
        </mxCell>
        <mxCell id="Insumo" value="&lt;b&gt;Insumo&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;nome&lt;br&gt;unidadeMedida&lt;br&gt;/estoqueAtual" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1740" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="note0" value="1. Registrar compra não aumenta estoque. A entrada ocorre somente no recebimento efetivo." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="901" width="1990" height="34" />
        </mxCell>
        <mxCell id="note1" value="2. Uma compra admite vários recebimentos; cada recebimento pertence a uma única compra (RF36/RN28)." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="935" width="1990" height="34" />
        </mxCell>
        <mxCell id="note2" value="3. Cada ItemRecebimento referencia um ItemCompra da mesma compra do recebimento." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="969" width="1990" height="34" />
        </mxCell>
        <mxCell id="note3" value="4. A soma recebida por item não excede a quantidade comprada; somente o efetivamente recebido gera entrada." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1003" width="1990" height="34" />
        </mxCell>
        <mxCell id="note4" value="5. O insumo recebido é identificado pelo ItemCompra; não é necessário duplicar essa associação." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1037" width="1990" height="34" />
        </mxCell>
        <mxCell id="legend" value="Legenda: linha = associação | losango preenchido = composição | 0..1 / 1 / 0..* / 1..* = multiplicidades | / = derivado" style="text;align=left;fontSize=19;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1104" width="1990" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="estoques-financeiro" name="Estoques, movimentações e financeiro provisório">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2120" pageHeight="1290">
