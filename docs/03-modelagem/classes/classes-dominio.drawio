0" y="850" width="300" height="160" /></mxCell><mxCell id="Insumo" value="&lt;b&gt;Insumo&lt;/b&gt;&lt;hr&gt;/ultimoPrecoCompra: decimal" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#F8FAFC;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="850" width="300" height="160" /></mxCell><mxCell id="note0" value="Usuário acumula perfis; atribuições concretas dependem de PD06. Cliente e fornecedor não são usuários externos." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1055" width="1500" height="28" /></mxCell><mxCell id="note1" value="Perfil → permissão é proposta estrutural; não concede permissões específicas nem define administrador." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1085" width="1500" height="28" /></mxCell><mxCell id="note2" value="Registro financeiro é conceitual: origem exclusiva compra OU venda/expedição. Eventos e automatização pendentes (PD05)." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1115" width="1500" height="28" /></mxCell><mxCell id="note3" value="Custo e último preço são derivados: receita, quantidades, rendimento e unidades compatíveis; critérios pendentes em PD11." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1145" width="1500" height="28" /></mxCell><mxCell id="note4" value="Sem contas a pagar/receber, pagamentos bancários ou contabilidade. Não existe classe Financeiro para representar um setor." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1175" width="1500" height="28" /></mxCell></root></mxGraphModel></diagram></mxfile>