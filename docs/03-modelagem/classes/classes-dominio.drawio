          <mxGeometry as="geometry" x="60" y="20" width="1950" height="50" />
        </mxCell>
        <mxCell id="subtitle" value="Gestão Integrada | Classes de domínio | Referência oficial de 20/10/2026 | Vista 3/3" style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="75" width="1950" height="40" />
        </mxCell>
        <mxCell id="relation0" style="endArrow=none;startArrow=none;startFill=1;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="Produto" target="MovimentacaoEstoque" edge="1" parent="1">
