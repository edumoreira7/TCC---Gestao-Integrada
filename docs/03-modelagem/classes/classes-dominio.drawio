          <mxGeometry as="geometry" x="1271" y="275.0" width="46.0" height="28" />
        </mxCell>
        <mxCell id="relation1-label" value="histórico de insumos" style="text;html=0;align=left;verticalAlign=middle;spacing=4;fontFamily=Arial;fontSize=18;fontStyle=0;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1094.0" y="235.0" width="180.0" height="28" />
        </mxCell>
        <mxCell id="Produto" value="&lt;b&gt;Produto&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;nome&lt;br&gt;unidadeMedida&lt;br&gt;/estoqueAtual&lt;br&gt;precoVenda" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="MovimentacaoEstoque" value="&lt;b&gt;MovimentacaoEstoque&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;dataHora&lt;br&gt;tipo&lt;br&gt;quantidade&lt;br&gt;unidadeMedida&lt;br&gt;origem" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="Insumo" value="&lt;b&gt;Insumo&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;nome&lt;br&gt;unidadeMedida&lt;br&gt;/estoqueAtual" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="150" width="320" height="240" />
        </mxCell>
        <mxCell id="RegistroFinanceiro" value="&lt;b&gt;RegistroFinanceiro&lt;/b&gt;&lt;hr&gt;id&lt;br&gt;dataRegistro&lt;br&gt;tipo&lt;br&gt;valor&lt;br&gt;descricao" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=21;fillColor=#F8FAFC;strokeColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1340" y="650" width="320" height="240" />
        </mxCell>
        <mxCell id="note0" value="1. {xor} Cada movimentação refere-se a exatamente um Produto OU um Insumo, nunca ambos ou nenhum." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="951" width="1990" height="34" />
        </mxCell>
        <mxCell id="note1" value="2. /estoqueAtual é saldo derivado do histórico, em unidade compatível; não representa outro item de estoque." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="985" width="1990" height="34" />
        </mxCell>
        <mxCell id="note2" value="3. Origem: recebimento efetivo, conclusão, cancelamento ou expedição, conforme o tipo de estoque." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1019" width="1990" height="34" />
        </mxCell>
        <mxCell id="note3" value="4. Início reserva insumos; conclusão baixa insumos, encerra reservas e recebe produtos acabados (RF34/RN26)." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1053" width="1990" height="34" />
        </mxCell>
        <mxCell id="note4" value="5. Cancelamento apura consumo/perdas sem duplicidade, libera reservas e recebe aproveitáveis (RN29)." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1087" width="1990" height="34" />
        </mxCell>
        <mxCell id="note5" value="6. RegistroFinanceiro mantém somente valores básicos; vínculos e eventos automáticos aguardam PD05." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1121" width="1990" height="34" />
        </mxCell>
        <mxCell id="note6" value="7. Custo: receita × último preço de compra, considerando rendimento e unidades. Preço de venda manual." style="text;align=left;fontSize=20;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1155" width="1990" height="34" />
        </mxCell>
        <mxCell id="legend" value="Legenda: linha = associação | losango preenchido = composição | 0..1 / 1 / 0..* / 1..* = multiplicidades | / = derivado" style="text;align=left;fontSize=19;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1224" width="1990" height="40" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
