          <mxGeometry as="geometry" x="452.5" y="235.0" width="183.0" height="28" />
        </mxCell>
        <mxCell id="relation1" style="endArrow=none;startArrow=none;startFill=1;rounded=0;html=0;strokeColor=#475569;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" source="MovimentacaoEstoque" target="Insumo" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1" />
