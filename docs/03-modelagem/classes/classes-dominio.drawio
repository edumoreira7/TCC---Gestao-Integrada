oduto" value="&lt;b&gt;MovimentacaoProduto&lt;/b&gt;&lt;hr&gt;data: dataHora&lt;br&gt;tipo: entrada | saida&lt;br&gt;quantidade: decimal" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#F8FAFC;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="850" width="300" height="160" /></mxCell><mxCell id="Expedicao" value="&lt;b&gt;Expedicao&lt;/b&gt;&lt;hr&gt;data: dataHora" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#F8FAFC;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1200" width="300" height="160" /></mxCell><mxCell id="SaldoProduto" value="&lt;b&gt;SaldoProduto&lt;/b&gt;&lt;hr&gt;/quantidadeFisica: decimal" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#F8FAFC;strokeColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="840" y="850" width="300" height="160" /></mxCell><mxCell id="note0" value="Compra não gera entrada de estoque; o recebimento efetivo gera as movimentações de entrada." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1405" width="1500" height="28" /></mxCell><mxCell id="note1" value="Movimentação de insumo tem origem exclusiva: item recebido OU conclusão de OP. Produto: conclusão OU expedição." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1435" width="1500" height="28" /></mxCell><mxCell id="note2" value="Saldo é uma visão derivada do histórico; não define tabela, serviço ou mecanismo de persistência." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1465" width="1500" height="28" /></mxCell><mxCell id="note3" value="Compra → recebimentos 0..* é proposta para revisão: recebimentos parciais não estão aprovados." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1495" width="1500" height="28" /></mxCell><mxCell id="note4" value="Reservas/concorrência (PD10) e consumo/perdas no cancelamento (PD03) aguardam decisão; não são modelados como aprovados." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="1525" width="1500" height="28" /></mxCell></root></mxGraphModel></diagram><diagram id="acessos-valores" name="Acessos e valores das operações"><mxGraphModel page="1" pageWidth="1600" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Acessos e valores das operações" style="text;align=left;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="20" width="1450" height="50" /></mxCell><mxCell id="subtitle" value="Classes de domínio | Rascunho para revisão | 20/10/2026" style="text;align=left;fontSize=18;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="70" width="1450" height="30" /></mxCell><mxCell id="rel0" value="acumula" source="Usuario" target="Perfil" edge="1" parent="1" style="endArrow=none;startArrow=none;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="mult0a" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="rel0"><mxGeometry as="geometry" x="-1" y="15" relative="1" /></mxCell><mxCell id="mult0b" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="rel0"><mxGeometry as="geometry" x="1" y="15" relative="1" /></mxCell><mxCell id="rel1" value="concede [PD06]" source="Perfil" target="Permissao" edge="1" parent="1" style="endArrow=none;startArrow=none;fontSize=14;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="mul