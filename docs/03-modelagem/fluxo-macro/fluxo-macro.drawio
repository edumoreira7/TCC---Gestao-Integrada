<mxCell id="financeiro" value="&lt;font color=&quot;#0369A1&quot; style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Financeiro&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Acompanhar valores básicos das operações&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Eventos e automatização ainda a definir (PD05)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Sem contas a pagar/receber ou confirmação bancária&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#17202A;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="830" y="845" width="760" height="115" as="geometry" /></mxCell>
<mxCell id="regra" value="&lt;b&gt;Regras confirmadas e pendência&lt;/b&gt;&lt;br&gt;Todo pedido gera uma única OP automática; OP manual abastece estoque.&lt;br&gt;Lotes inteiros em ambas. PD12: abatimento de estoque acabado ainda pendente.&lt;br&gt;Demo não abate; pedido 15 / rendimento 10 → produz 20 e expede 15." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#17202A;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="845" width="690" height="115" as="geometry" /></mxCell>
<mxCell id="custos" value="&lt;b&gt;Custos e limites&lt;/b&gt;&lt;br&gt;Referência pela data/hora do último recebimento; sem recebimento, preço inicial; sem preço, indisponível.&lt;br&gt;Desempate por ID e limites do cancelamento são propostas provisórias do DER.&lt;br&gt;Cancelamento excepcional: consumo/perdas separados, liberar restante, receber aproveitáveis." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#17202A;fontFamily=Arial;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="1020" width="950" height="130" as="geometry" /></mxCell>
