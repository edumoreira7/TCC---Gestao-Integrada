<mxCell id="note0" value="Associações indicam participação funcional; não representam sequência, automatização ou uma matriz definitiva de permissões." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="1950" width="2080" height="32" as="geometry"/></mxCell>
<mxCell id="note1" value="Usuário interno autorizado: categoria genérica para CU01, CU02 e CU20; responsável específico e permissões dependem de PD06." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="1984" width="2080" height="32" as="geometry"/></mxCell>
<mxCell id="note2" value="CU15: movimentações do cancelamento em PD03. CU19: eventos financeiros em PD05. Custos e unidades em PD11." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="2018" width="2080" height="32" as="geometry"/></mxCell>
<mxCell id="note3" value="Todo pedido gera uma única OP. Sem acesso de clientes/fornecedores, produção parcial, expedição parcial ou financeiro completo." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="60" y="2052" width="2080" height="32" as="geometry"/></mxCell>
